DATABASE_URL="postgresql://postgres:postgres@localhost:5432/physics_question_bank?schema=public"
APP_BASE_URL="http://localhost:3000"
LOCAL_UPLOAD_DIR="./uploads"
AGENT_API_KEY_DEV="dev-agent-key"
# 32-byte hex. Wraps stored agent key plaintext so teachers can copy later.
# Generate a unique value: openssl rand -hex 32
AGENT_KEY_WRAP_SECRET=""
# First teacher login. Seed hashes this; do not commit a real password.
TEACHER_BOOTSTRAP_USERNAME="owner"
TEACHER_BOOTSTRAP_PASSWORD=""
# TRUST_PROXY is unset by default. v1 assumes a single instance: without this
# flag, unlock rate limiting counts every client in one "local" bucket.
# Set TRUST_PROXY=true only behind a trusted reverse proxy.
# Rule fixtures, not OCR/LLM. Default off. Tests import worker functions directly.
# ENABLE_MOCK_PARSE=true
# ENABLE_MOCK_CLASSIFY=true
